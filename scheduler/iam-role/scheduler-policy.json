{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartOdcrWorkflow",
      "Effect": "Allow",
      "Action": "states:StartExecution",
      "Resource": "arn:aws:states:us-east-1:252303746749:stateMachine:odcr-capacity-reservation"
    },
    {
      "Sid": "SendFailedInvocationsToDlq",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:252303746749:odcr-scheduler-dlq"
    }
  ]
}
