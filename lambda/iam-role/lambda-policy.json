{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeInstancesAndOdcrs",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeCapacityReservations"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:252303746749:log-group:/aws/lambda/odcr-describe-instances:*"
    }
  ]
}
